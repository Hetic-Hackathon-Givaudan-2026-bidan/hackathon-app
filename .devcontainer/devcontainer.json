{
  "name": "Hackathon",
  // L'éditeur (VS Code ou Zed) démarre toute la stack, puis s'attache au service « dev »
  "dockerComposeFile": ["../compose.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",

  // Outils en plus de l'image : ici, la CLI GitHub (gh)
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {},
  },

  // Les mêmes extensions et réglages pour toute l'équipe
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-pull-request-github",
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
      },
    },
    // Zed ne lit ici que les extensions : ses réglages sont dans .zed/settings.json
    // (ESLint et Prettier sont intégrés à Zed, pas besoin d'extension)
    "zed": {
      "extensions": ["dockerfile", "docker-compose"],
    },
  },

  // Les ports 3000 et 5173 sont publiés dans compose.yaml, sur 127.0.0.1 uniquement.
  // Pas de forwardPorts : Zed les publierait sur toutes les interfaces (tout le réseau).
  // Et on dit à VS Code de ne pas les re-transférer (ils sont déjà sur localhost).
  "portsAttributes": {
    "3000": { "label": "API", "onAutoForward": "ignore" },
    "5173": { "label": "Front", "onAutoForward": "ignore" },
  },

  // Une fois, à la création du conteneur.
  // Forme tableau obligatoire pour Zed : il casse la forme chaîne (il la relance
  // dans un second `sh -c` sans guillemets, et seul `git` est exécuté).
  // Pas d'argument contenant des espaces : Zed les recolle sans guillemets.
  "postCreateCommand": ["git", "config", "--global", "--add", "safe.directory", "/workspace"],
}
