{
  "name": "hackathon",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
